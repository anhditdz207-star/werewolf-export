# URL of the Ma Sói Online server (Socket.io + REST auth endpoint).
VITE_SERVER_URL=http://localhost:4000

# OAuth Client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs > Web application).
# Add your deployed client origin(s) to "Authorized JavaScript origins".
# Leave empty to disable the "Đăng nhập với Google" button (falls back to a clear error message).
VITE_GOOGLE_CLIENT_ID=
